# Copy to .env.local and replace YOUR_LOCAL_POSTGRES_PASSWORD locally.
# Do not commit .env.local or send credentials through chat.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@127.0.0.1:55432/promptmaster_dev

# Route Handlers are intended for local development only and return 404 in production mode.
PROMPTMASTER_DEMO_API_ENABLED=true

# Opt-in browser synchronization. Keep false or unset to use the local demo store only.
NEXT_PUBLIC_PROMPTMASTER_DEMO_API_ENABLED=true

# Stage 13A-1 model service is disabled by default. Set live only in a private local environment.
PROMPTMASTER_MODEL_MODE=disabled
PROMPTMASTER_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PRODUCT_VERSION=DeepSeek-V4.1-Flash-1017
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Four exact SiliconFlow model IDs are allowlisted server-side; selected per request.
# SiliconFlow always uses zero automatic retries; its thinking budget is a soft bound.
# Independent whole-request deadline (1,000-600,000 ms); not a billing cap.
SILICONFLOW_MODEL_TIMEOUT_MS=300000
# Legacy direct DeepSeek deadline; does not control SiliconFlow.
PROMPTMASTER_MODEL_TIMEOUT_MS=30000
# Thinking requests allow a longer deadline; does not change SiliconFlow's timeout.
PROMPTMASTER_DEEPSEEK_THINKING_TIMEOUT_MS=300000
PROMPTMASTER_MODEL_MAX_RETRIES=2
# New requests always use the model registry's maximum output limit.
# Legacy PROMPTMASTER_MODEL_MAX_OUTPUT_TOKENS and
# PROMPTMASTER_PELICAN_MAX_OUTPUT_TOKENS are ignored.
# New Pelican calls have no local generation
# deadline; legacy PROMPTMASTER_PELICAN_TIMEOUT_MS is ignored. Existing Prompt flows
# retain their finite deadlines; account and platform quotas still apply.
# Sample-level parallel workers per Pelican batch (1-5, default 3). The supplier's
# own rate limits and account quotas still apply per request.
PROMPTMASTER_PELICAN_CONCURRENCY=3
PROMPTMASTER_MODEL_DAILY_TOKEN_LIMIT=4500000
# Community anti-spam limit per account per UTC day; identical for every tier.
PROMPTMASTER_COMMUNITY_PUBLISH_DAILY_LIMIT=20
# Local operational guardrail only; not a Free/Pro entitlement.
PROMPTMASTER_MODEL_DAILY_COST_LIMIT_USD=6
# auto reserves at peak rates; discounts remain subject to provider reconciliation.
PROMPTMASTER_MODEL_PRICING_WINDOW=auto

# Manual Alipay billing. Keep disabled until the real collection details are supplied.
# QR file must exist under public/payments/ and be a PNG/JPEG/WebP image <=2MB.
PROMPTMASTER_PAYMENT_ENABLED=false
PROMPTMASTER_PAYMENT_QR_PATH=
PROMPTMASTER_PAYMENT_RECEIVER_ACCOUNT=
PROMPTMASTER_PAYMENT_RECEIVER_HINT=
PROMPTMASTER_PAYMENT_REFUND_CONTACT=

# Optional WeChat manual channel; the master PAYMENT_ENABLED switch must also be true.
PROMPTMASTER_WECHAT_PAYMENT_ENABLED=false
PROMPTMASTER_WECHAT_PAYMENT_QR_PATH=
PROMPTMASTER_WECHAT_PAYMENT_RECEIVER_ACCOUNT=
PROMPTMASTER_WECHAT_PAYMENT_RECEIVER_HINT=
PROMPTMASTER_WECHAT_PAYMENT_REFUND_CONTACT=
